# Merge these settings into an existing .env; do not replace your existing API key values.
# OPENAI_API_KEY and DEEPGRAM_API_KEY are supplied only to the running app container.
# Keep those assignments and values unchanged when updating an older .env file.

# Current SQLite app settings used by Compose.
DATA_ROOT=/data
DATABASE_PATH=/data/runs/voice-evaluation.sqlite3
WORKER_QUEUE_CAPACITY=32
MAX_PENDING_RUNS=32
MAX_SAMPLES_PER_RUN=100
MAX_WORKER_CONCURRENCY=16

# Host folder containing read-only manifests/ and audio/ subdirectories.
DATASET_SOURCE_DIR=./data/datasets
VOICE_EVAL_PORT=8080

# Legacy setting: current SQLite runtime ignores DATABASE_URL.
# If existing runs live in a database referenced by DATABASE_URL, export/copy them
# before switching. No automatic DATABASE_URL-to-SQLite migration is performed.
