# Add provider credentials only to an ignored local .env file or a secret manager.
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Container data root; mount prepared datasets beneath this path.
DATA_ROOT=/data
# Persistent SQLite database path inside the app data volume.
DATABASE_PATH=/data/runs/voice-evaluation.sqlite3
WORKER_QUEUE_CAPACITY=32
MAX_PENDING_RUNS=32
MAX_SAMPLES_PER_RUN=100
MAX_WORKER_CONCURRENCY=16
